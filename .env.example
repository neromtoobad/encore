# Copy to .env and fill in. Any key left empty switches that source to labelled
# demo data, so the app still runs end to end.

# Qloo hackathon key (works only against hackathon.api.qloo.com)
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Ticketmaster Discovery API consumer key (developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# Claude runs the planning agent. Without it, a rule-based planner is used.
ANTHROPIC_API_KEY=
# ENCORE_MODEL=claude-opus-5-5

# PORT=8794
